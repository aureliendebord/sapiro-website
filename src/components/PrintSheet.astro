---
/**
 * Version imprimable des pages de questions (séries 10/20/50/100, questions
 * difficiles). Activée par `printable: true` dans le frontmatter.
 *
 * À l'impression (bouton ou Ctrl/Cmd+P) : questions seules, réponses
 * regroupées en fin de document (format soirée quiz), sans en-tête, CTA ni
 * articles liés. Le « PDF » est celui du navigateur (Imprimer → Enregistrer en
 * PDF) : pas de fichier PDF à part, qui pourrait ranker à la place de la page.
 *
 * Une question = un paragraphe qui commence par `**N. …**` ; la réponse
 * commence au deuxième `<strong>` du même paragraphe.
 */
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  fr: { button: 'Imprimer / PDF', answers: 'Réponses', footer: 'Plus de quiz gratuits sur sapiro.app' },
  en: { button: 'Print / PDF', answers: 'Answers', footer: 'More free quizzes at sapiro.app' },
  es: { button: 'Imprimir / PDF', answers: 'Respuestas', footer: 'Más quizzes gratis en sapiro.app' },
  de: { button: 'Drucken / PDF', answers: 'Lösungen', footer: 'Mehr kostenlose Quiz auf sapiro.app' },
}[lang];
---

<div class="print-sheet__bar">
  <button type="button" class="print-sheet__btn" id="print-sheet-btn" data-umami-event="print-click">
    <span aria-hidden="true">🖨️</span> {copy.button}
  </button>
</div>

<script is:inline define:vars={{ answersLabel: copy.answers, footerLabel: copy.footer }}>
  (function () {
    var built = false;

    function build() {
      if (built) return;
      var content = document.getElementById('article-content');
      if (!content) return;
      var items = [];
      content.querySelectorAll(':scope > p').forEach(function (p) {
        var first = p.firstElementChild;
        if (!first || first.tagName !== 'STRONG' || !/^\d+\.\s/.test(first.textContent || '')) return;
        var strongs = p.querySelectorAll(':scope > strong');
        if (strongs.length < 2) return;
        var answerStart = strongs[1];
        var answer = document.createElement('span');
        answer.className = 'print-sheet__answer';
        var node = answerStart;
        while (node) {
          var next = node.nextSibling;
          answer.appendChild(node);
          node = next;
        }
        p.appendChild(answer);
        var num = (first.textContent || '').match(/^(\d+)\./)[1];
        items.push({ num: num, html: answer.innerHTML });
      });
      if (!items.length) return;
      var key = document.createElement('section');
      key.className = 'print-sheet__key';
      var h = document.createElement('h2');
      h.textContent = answersLabel;
      key.appendChild(h);
      var list = document.createElement('ol');
      items.forEach(function (it) {
        var li = document.createElement('li');
        li.value = Number(it.num);
        li.innerHTML = it.html;
        list.appendChild(li);
      });
      key.appendChild(list);
      var foot = document.createElement('p');
      foot.className = 'print-sheet__footer';
      foot.textContent = footerLabel;
      key.appendChild(foot);
      content.appendChild(key);
      built = true;
    }

    window.addEventListener('beforeprint', build);
    var btn = document.getElementById('print-sheet-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        build();
        window.print();
      });
    }
  })();
</script>

<style>
  .print-sheet__bar {
    margin: 0 0 24px;
  }

  .print-sheet__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    border-radius: 999px;
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  :global(.print-sheet__key) {
    display: none;
  }

  @media print {
    @page {
      margin: 16mm 14mm;
    }

    :global(.header),
    :global(.footer),
    :global(.breadcrumbs),
    :global(.article-meta),
    :global(.article-info),
    :global(.article-hero),
    :global(.article-content figure),
    :global(.blog-quiz),
    :global(.blog-cta),
    :global(.inline-cta),
    :global(.cluster-box),
    :global(.faq-section),
    :global(.related-posts),
    :global(.article-back),
    :global(.sticky-bar),
    .print-sheet__bar,
    :global(.print-sheet__answer) {
      display: none !important;
    }

    :global(body) {
      background: #fff !important;
      color: #000 !important;
    }

    :global(.article-content a) {
      color: inherit !important;
      text-decoration: none !important;
    }

    :global(.article-content p) {
      break-inside: avoid;
    }

    :global(.print-sheet__key) {
      display: block !important;
      break-before: page;
    }

    :global(.print-sheet__key li) {
      margin: 0 0 6px;
    }

    :global(.print-sheet__footer) {
      display: block;
      margin-top: 24px;
      font-size: 12px;
      text-align: center;
    }
  }
</style>
