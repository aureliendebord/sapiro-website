---
import type { Lang } from '../../i18n';
import { playGameUrl } from '../../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  fr: {
    badge: 'Nouveau • Les duels sont arrivés',
    titleA: 'Deviens',
    titleHighlight: 'incollable',
    titleB: 'en culture générale.',
    subtitle: 'Géographie, histoire, art, nature, monuments. 2 000+ questions vérifiées. Sans pub, et tes données ne sont jamais revendues.',
    ctaPrimary: 'Télécharger gratuitement',
    ctaSecondary: 'Jouer en ligne',
    trophyAmount: '+30',
    trophyLabel: 'Duel gagné',
    streakTitle: '21 jours',
    streakLabel: 'Série du défi du jour',
    slideAlts: {
      home: 'Accueil de l\'app SAPIRO',
      duel: 'Écran de duel SAPIRO',
      flags: 'Quiz Drapeaux SAPIRO',
      paintings: 'Quiz Tableaux SAPIRO',
      trail: 'Parcours SAPIRO',
    },
  },
  en: {
    badge: 'New • Duels are here',
    titleA: 'Become',
    titleHighlight: 'unbeatable',
    titleB: 'at general knowledge.',
    subtitle: 'Geography, history, art, nature, monuments. 2,000+ verified questions. No ads, and your data is never sold.',
    ctaPrimary: 'Download for free',
    ctaSecondary: 'Play online',
    trophyAmount: '+30',
    trophyLabel: 'Duel won',
    streakTitle: '21 days',
    streakLabel: 'Daily challenge streak',
    slideAlts: {
      home: 'SAPIRO app home',
      duel: 'SAPIRO duel screen',
      flags: 'Flags Quiz SAPIRO',
      paintings: 'Paintings Quiz SAPIRO',
      trail: 'SAPIRO trail',
    },
  },
  es: {
    badge: 'Novedad • Llegan los duelos',
    titleA: 'Hazte',
    titleHighlight: 'imbatible',
    titleB: 'en cultura general.',
    subtitle: 'Geografia, historia, arte, naturaleza, monumentos. 2 000+ preguntas verificadas. Sin anuncios, y tus datos nunca se venden.',
    ctaPrimary: 'Descargar gratis',
    ctaSecondary: 'Jugar en línea',
    trophyAmount: '+30',
    trophyLabel: 'Duelo ganado',
    streakTitle: '21 días',
    streakLabel: 'Racha del reto diario',
    slideAlts: {
      home: 'Inicio de la app SAPIRO',
      duel: 'Pantalla de duelo SAPIRO',
      flags: 'Quiz Banderas SAPIRO',
      paintings: 'Quiz Cuadros SAPIRO',
      trail: 'Recorrido SAPIRO',
    },
  },
};

const t = copy[lang];
---

<section class="hero-v2">
  <div class="bg-bay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-left">
      <div class="badge">
        <img src="/images/v3/swords.webp" class="badge-ico" alt="" aria-hidden="true" width="22" height="22" />
        <span>{t.badge}</span>
      </div>

      <h1 class="title">
        {t.titleA}<br />
        <span class="highlight">{t.titleHighlight}</span><br />
        {t.titleB}
      </h1>

      <p class="subtitle">{t.subtitle}</p>

      <div class="ctas">
        <a href="#download" class="cta-primary">
          <span>{t.ctaPrimary}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={playGameUrl('hero', lang)} class="cta-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>{t.ctaSecondary}</span>
        </a>
      </div>
    </div>

    <div class="hero-right">
      <div class="phone-stage">
        <div class="orbit" aria-hidden="true">
          <span class="orbit-emoji orbit-emoji-1" style="--a:0deg; --r:180px">🇫🇷</span>
          <span class="orbit-emoji orbit-emoji-2" style="--a:60deg; --r:190px"><img src="/images/icons/moai.webp" class="app-ico" alt="" aria-hidden="true" /></span>
          <span class="orbit-emoji orbit-emoji-3" style="--a:120deg; --r:175px"><img src="/images/icons/palette.webp" class="app-ico" alt="" aria-hidden="true" /></span>
          <span class="orbit-emoji orbit-emoji-4" style="--a:180deg; --r:195px"><img src="/images/icons/lion.webp" class="app-ico" alt="" aria-hidden="true" /></span>
          <span class="orbit-emoji orbit-emoji-5" style="--a:240deg; --r:180px">🇯🇵</span>
          <span class="orbit-emoji orbit-emoji-6" style="--a:300deg; --r:185px"><img src="/images/icons/classical-building.webp" class="app-ico" alt="" aria-hidden="true" /></span>
        </div>

        <div class="phone-tilt">
          <div class="phone">
            <div class="phone-screen">
              <img src={`/images/screenshots/${lang}/v3/02-home.webp`} alt={t.slideAlts.home} class="slide slide-1" loading="eager" width="560" height="1217" />
              <img src={`/images/screenshots/${lang}/v3/10-duel-vs.webp`} alt={t.slideAlts.duel} class="slide slide-2" loading="lazy" width="560" height="1217" />
              <img src={`/images/screenshots/${lang}/v3/04-quiz-geography.webp`} alt={t.slideAlts.flags} class="slide slide-3" loading="lazy" width="560" height="1217" />
              <img src={`/images/screenshots/${lang}/v3/01-quiz-art.webp`} alt={t.slideAlts.paintings} class="slide slide-4" loading="lazy" width="560" height="1217" />
              <img src={`/images/screenshots/${lang}/v3/09-journeys.webp`} alt={t.slideAlts.trail} class="slide slide-5" loading="lazy" width="560" height="1217" />
            </div>
          </div>
        </div>

        <div class="floating-card card-top">
          <img src="/images/v3/cup.webp" class="card-ico" alt="" aria-hidden="true" width="30" height="34" />
          <div class="card-content">
            <div class="card-num">{t.trophyAmount}</div>
            <div class="card-label">{t.trophyLabel}</div>
          </div>
        </div>

        <div class="floating-card card-bottom">
          <img src="/images/v3/flame.webp" class="card-ico" alt="" aria-hidden="true" width="28" height="34" />
          <div class="card-content">
            <div class="card-num">{t.streakTitle}</div>
            <div class="card-label">{t.streakLabel}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* DA V3 de l'app (2.1.0) : la baie illustrée en plein cadre sous un voile
     crème, texte encre, orange réservé aux boutons d'action. */
  .hero-v2 {
    position: relative;
    overflow: hidden;
    padding: 120px 0 80px;
    background: linear-gradient(180deg, #FFFDFA 0%, #FBF1E8 60%, #F6DCCB 100%);
    color: #2A1A14;
    isolation: isolate;
  }

  .bg-bay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/images/bg/baie.webp') right 38% / max(60%, 780px) auto no-repeat;
    -webkit-mask-image: linear-gradient(90deg, transparent 42%, rgba(0, 0, 0, 0.5) 62%, #000 82%);
    mask-image: linear-gradient(90deg, transparent 42%, rgba(0, 0, 0, 0.5) 62%, #000 82%);
    opacity: 0.9;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Pastille « Nouveau » en verre dépoli, comme les cartes de l'accueil de l'app */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 10px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 28px;
    box-shadow: 0 6px 18px -10px rgba(120, 50, 20, 0.28);
  }

  .badge-ico { width: 22px; height: 22px; object-fit: contain; }

  .title {
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.04;
    margin-bottom: 28px;
  }

  /* Mot surligné pêche, comme les accroches des captures stores V3 */
  .highlight {
    display: inline-block;
    background: #FAD3C4;
    border-radius: 0.2em;
    padding: 0 0.14em;
    margin: 0.04em 0;
  }

  .subtitle {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: rgba(42, 26, 20, 0.72);
    font-weight: 600;
    line-height: 1.6;
    max-width: 540px;
    margin-bottom: 36px;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  /* Bouton 3D orange de l'app (V3.button) */
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: linear-gradient(180deg, #FF8A5B 0%, #FF5E3A 55%, #E9401F 100%);
    color: #fff;
    border-radius: 999px;
    font-weight: 800;
    font-size: 16px;
    box-shadow: 0 5px 0 #C9441F, 0 14px 26px -12px rgba(201, 68, 31, 0.6);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #C9441F, 0 18px 30px -12px rgba(201, 68, 31, 0.65);
  }

  .cta-primary:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #C9441F;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    color: #2A1A14;
    border-radius: 999px;
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 6px 18px -10px rgba(120, 50, 20, 0.28);
    transition: background 0.2s, transform 0.2s;
  }

  .cta-secondary:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .cta-secondary svg { color: #FF5E3A; }

  .hero-right { display: flex; justify-content: center; align-items: center; }

  .phone-stage {
    position: relative;
    width: 420px;
    height: 560px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .orbit {
    position: absolute;
    inset: 0;
    animation: orbitRotate 40s linear infinite;
  }

  .orbit-emoji {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 38px;
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--a) * -1));
    filter: drop-shadow(0 6px 10px rgba(120, 50, 20, 0.22));
    animation: orbitBob 3.6s ease-in-out infinite;
  }

  .orbit-emoji-1 { animation-delay: 0s; }
  .orbit-emoji-2 { animation-delay: 0.4s; }
  .orbit-emoji-3 { animation-delay: 0.9s; }
  .orbit-emoji-4 { animation-delay: 1.3s; }
  .orbit-emoji-5 { animation-delay: 1.8s; }
  .orbit-emoji-6 { animation-delay: 2.2s; }

  @keyframes orbitRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes orbitBob {
    0%, 100% { scale: 1; }
    50% { scale: 1.12; }
  }

  .phone-tilt {
    transform: perspective(1400px) rotateY(-12deg) rotateX(5deg) rotateZ(-2deg);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 34px 44px rgba(120, 50, 20, 0.32));
  }

  .phone-stage:hover .phone-tilt {
    transform: perspective(1400px) rotateY(-6deg) rotateX(3deg) rotateZ(-1deg);
  }

  .phone {
    position: relative;
    width: 280px;
    height: 600px;
    background: #1A1816;
    border-radius: 48px;
    padding: 9px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.08);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 40px;
    overflow: hidden;
    background: #FBF4EB;
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    animation: slideShow 20s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .slide-1 { opacity: 1; animation-delay: 0s; }
  .slide-2 { animation-delay: 4s; }
  .slide-3 { animation-delay: 8s; }
  .slide-4 { animation-delay: 12s; }
  .slide-5 { animation-delay: 16s; }

  @keyframes slideShow {
    0% { opacity: 0; transform: translateX(8%) scale(1.02); }
    2% { opacity: 1; transform: translateX(0) scale(1); }
    18% { opacity: 1; transform: translateX(0) scale(1); }
    22% { opacity: 0; transform: translateX(-8%) scale(1.02); }
    100% { opacity: 0; transform: translateX(8%) scale(1.02); }
  }

  /* Cartes flottantes en verre, trophées et série comme sur l'accueil de l'app */
  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.95);
    color: #2A1A14;
    border-radius: 20px;
    box-shadow: 0 18px 34px -14px rgba(120, 50, 20, 0.4);
    z-index: 3;
  }

  .card-top {
    top: 12%;
    right: -10px;
    animation: floatCardTop 5s ease-in-out infinite;
  }

  .card-bottom {
    bottom: 18%;
    left: -30px;
    animation: floatCardBottom 5.5s ease-in-out infinite 1.2s;
  }

  @keyframes floatCardTop {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-10px) rotate(1.5deg); }
  }

  @keyframes floatCardBottom {
    0%, 100% { transform: translateY(0) rotate(1deg); }
    50% { transform: translateY(-12px) rotate(-1.5deg); }
  }

  .card-ico { width: 30px; height: 34px; object-fit: contain; }

  .card-num { font-family: var(--font-display); font-size: 18px; font-weight: 800; line-height: 1.1; }
  .card-top .card-num { color: #E9960C; }
  .card-label { font-size: 12px; font-weight: 600; color: rgba(42, 26, 20, 0.6); }

  @media (max-width: 968px) {
    .hero-v2 { padding: 96px 0 60px; }
    .bg-bay {
      background: url('/images/bg/baie.webp') center 40% / cover no-repeat;
      -webkit-mask-image: linear-gradient(180deg, transparent 38%, rgba(0, 0, 0, 0.6) 62%, #000 85%);
      mask-image: linear-gradient(180deg, transparent 38%, rgba(0, 0, 0, 0.6) 62%, #000 85%);
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }
    .subtitle { margin-left: auto; margin-right: auto; }
    .ctas, .badge { justify-content: center; }
    .phone-stage { width: 340px; height: 500px; }
    .phone { width: 230px; height: 494px; border-radius: 40px; }
    .phone-screen { border-radius: 32px; }
    .card-top { right: -30px; }
    .card-bottom { left: -40px; }
  }

  @media (max-width: 520px) {
    .hero-v2 { padding: 80px 0 48px; }
    .ctas { flex-direction: column; align-items: stretch; }
    .cta-primary, .cta-secondary { justify-content: center; }
    .phone-stage { width: 280px; height: 440px; }
    .phone { width: 200px; height: 430px; border-radius: 36px; padding: 7px; }
    .phone-screen { border-radius: 30px; }
    .orbit-emoji { font-size: 28px; }
    .card-top, .card-bottom { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit { animation-duration: 120s !important; }
  }
</style>
