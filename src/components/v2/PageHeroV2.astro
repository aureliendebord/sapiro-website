---
import type { Lang } from '../../i18n';
import { getLocalePath } from '../../i18n';

interface Props {
  lang: Lang;
  kicker?: string;
  title: string;
  highlight?: string;
  subtitle?: string;
  backLabel?: string;
  align?: 'center' | 'left';
}

const { lang, kicker, title, highlight, subtitle, backLabel, align = 'center' } = Astro.props;
---

<section class={`page-hero align-${align}`}>
  <div class="bg-bay" aria-hidden="true"></div>

  <div class="container inner">
    {backLabel && (
      <a href={getLocalePath('/', lang)} class="back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        {backLabel}
      </a>
    )}

    {kicker && (
      <span class="kicker">{kicker}</span>
    )}

    <h1 class="title">
      {title}
      {highlight && (
        <>
          {' '}
          <span class="hl">
{highlight}</span>
        </>
      )}
    </h1>

    {subtitle && (
      <p class="subtitle">{subtitle}</p>
    )}

    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 120px 0 72px;
    background: linear-gradient(180deg, #FFFDFA 0%, #FBF1E8 60%, #F6DCCB 100%);
    color: #2A1A14;
    overflow: hidden;
    isolation: isolate;
  }

  .align-center { text-align: center; }
  .align-left { text-align: left; }

  /* Fond V3 de l'app : la baie illustrée sous un voile crème épais,
     comme les écrans secondaires (ScreenBackground veil 0.72). */
  .bg-bay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(255, 253, 250, 0.9) 0%, rgba(255, 253, 250, 0.72) 55%, rgba(251, 241, 232, 0.55) 100%),
      url('/images/bg/baie.webp') center 62% / cover no-repeat;
  }

  .inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .align-center .inner {
    margin: 0 auto;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    color: rgba(42, 26, 20, 0.7);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 24px;
    transition: all 0.2s;
  }

  .back:hover {
    background: #fff;
    color: #2A1A14;
    gap: 10px;
  }

  .kicker {
    display: inline-block;
    padding: 6px 14px;
    background: #FFE4DB;
    color: #B13818;
    border: 1px solid rgba(255, 94, 58, 0.2);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 20px;
  }

  /* Mot surligné pêche, comme les accroches des captures stores V3 */
  .hl {
    display: inline;
    background: #FAD3C4;
    border-radius: 0.22em;
    padding: 0 0.14em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .subtitle {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: rgba(42, 26, 20, 0.7);
    line-height: 1.6;
    max-width: 680px;
  }

  .align-center .subtitle { margin: 0 auto; }

  @media (max-width: 768px) {
    .page-hero { padding: 100px 0 56px; }
  }
</style>
