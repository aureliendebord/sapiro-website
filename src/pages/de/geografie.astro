---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileCta from '../../components/v2/StickyMobileCta.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const lang = 'de';
const t = getTranslations(lang);

// Nur ein Teil der Artikel ist auf Deutsch übersetzt: Jede kuratierte Liste
// wird über translationKey aufgelöst, Einträge ohne deutschen Artikel fallen weg,
// leere Abschnitte werden ausgeblendet.
const allPosts = await getCollection('blog');
const dePosts = allPosts
  .filter(p => p.data.lang === 'de')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byKey = new Map(dePosts.map(p => [p.data.translationKey, p]));

const curated = [
  {
    title: 'Das Wichtigste',
    items: [
      { key: 'quiz-capitales-monde', label: 'Quiz: Hauptstädte der Welt' },
      { key: 'quiz-capitales-continent', label: 'Quiz: Hauptstädte nach Kontinent' },
      { key: 'drapeaux-difficiles', label: 'Die 15 schwierigsten Flaggen' },
      { key: 'signification-drapeaux', label: 'Was die Flaggen bedeuten' },
      { key: 'erreurs-geographie', label: 'Typische Geografie-Irrtümer' },
      { key: 'quiz-drapeaux-monde', label: 'Kostenloses Flaggenquiz online' },
    ],
  },
  {
    title: 'Geografische Kuriositäten',
    items: [
      { key: 'pays-moins-visites', label: 'Die 15 am wenigsten besuchten Länder' },
      { key: 'plus-petits-pays', label: 'Die 10 kleinsten Länder' },
      { key: 'pays-disparus', label: 'Länder, die es nicht mehr gibt' },
      { key: 'frontieres-etranges', label: 'Die 10 seltsamsten Grenzen' },
      { key: 'origine-noms-pays', label: 'Woher die Ländernamen kommen' },
      { key: 'test-pays-personnalite', label: 'Welches Land passt zu deiner Persönlichkeit?' },
      { key: 'monuments-plus-visites', label: 'Die meistbesuchten Monumente der Welt' },
    ],
  },
  {
    title: 'Lernen mit der Familie und in der Schule',
    items: [
      { key: 'geographie-enfants', label: 'Geografie für Kinder' },
      { key: 'geographie-famille', label: 'Geografie mit der ganzen Familie' },
      { key: 'apprendre-pays-enfants', label: 'Kindern die Länder der Welt beibringen' },
      { key: 'meilleures-apps-geographie', label: 'Die besten Geografie-Apps' },
    ],
  },
];

const sections = curated
  .map(s => ({
    title: s.title,
    items: s.items
      .flatMap(i => {
        const post = byKey.get(i.key);
        return post ? [{ label: i.label, post }] : [];
      }),
  }))
  .filter(s => s.items.length > 0);

const shownKeys = new Set(curated.flatMap(s => s.items.map(i => i.key)));
const geoCategories = ['geographie', 'drapeaux', 'voyage', 'culture-generale'];
const moreArticles = dePosts.filter(
  p => geoCategories.includes(p.data.category) && !shownKeys.has(p.data.translationKey),
);

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Geografie der Welt: Länder, Flaggen, Hauptstädte",
  "description": "Alles über die Geografie der Welt: 197 Länder, Flaggen, Hauptstädte, Grenzen, Kulturen.",
  "url": "https://sapiro.app/de/geografie/",
  "inLanguage": "de"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Wie viele Länder gibt es auf der Welt?", "acceptedAnswer": { "@type": "Answer", "text": "Es gibt 197 anerkannte Länder auf der Welt: die 193 UN-Mitglieder plus Vatikanstadt, Palästina, Taiwan und Kosovo (je nach Anerkennung)." } },
    { "@type": "Question", "name": "Was ist die Hauptstadt von Australien?", "acceptedAnswer": { "@type": "Answer", "text": "Die Hauptstadt Australiens ist Canberra, nicht Sydney und nicht Melbourne. Die Planstadt wurde 1913 gegründet, um die Rivalität zwischen Sydney und Melbourne zu beenden." } },
    { "@type": "Question", "name": "Welche Flaggen sind am schwersten zu erkennen?", "acceptedAnswer": { "@type": "Answer", "text": "Am häufigsten verwechselt werden Tschad und Rumänien (fast identisch), Monaco und Indonesien (Rot und Weiß vertauscht), die Slowakei und Slowenien (sehr ähnlich) sowie die nordischen Flaggen untereinander." } },
    { "@type": "Question", "name": "Welches ist das kleinste Land der Welt?", "acceptedAnswer": { "@type": "Answer", "text": "Die Vatikanstadt ist mit 0,49 km² und rund 825 Einwohnern das kleinste Land der Welt. Danach folgen Monaco (2,02 km²) und Nauru (21 km²)." } },
    { "@type": "Question", "name": "Wie lernt man alle Länder der Welt?", "acceptedAnswer": { "@type": "Answer", "text": "Am effektivsten lernst du nach Kontinenten (nicht alphabetisch): Fang mit 30 wichtigen Ländern an und erweitere dann Schritt für Schritt. Fünfzehn Minuten Quiz pro Tag reichen, um dir die 197 Länder in 3 bis 6 Monaten einzuprägen." } }
  ]
};
---

<Layout title="Geografie der Welt: Länder, Flaggen, Hauptstädte | SAPIRO" description="Geografie der Welt: 197 Länder, Flaggen, Hauptstädte, Grenzen. Ratgeber, Quiz und Methoden, um wirklich etwas zu lernen." lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header lang={lang} t={t} />

  <main class="pillar-page">
    <article class="container">
      <header class="pillar-header">
        <h1>Geografie der Welt</h1>
        <p class="lede">197 Länder, unzählige Flaggen, Hauptstädte, die man ständig verwechselt. Alle unsere Ratgeber und Quiz, um die Geografie der Welt zu meistern.</p>
      </header>

      <section class="pillar-intro">
        <p>Geografie ist wohl der einfachste Einstieg ins Allgemeinwissen. Und kein Fachgebiet eignet sich besser für ein Quiz: Die Fragen sind sachlich und überprüfbar. Eine Hauptstadt, eine Flagge, eine Grenze. Du weißt, wo du stehst, und du siehst, wie du besser wirst.</p>
        <p>SAPIRO deckt alle 197 anerkannten Länder mit Flaggen, Hauptstädten und Besonderheiten ab, dazu Themenfragen (Wirtschaftsgeografie, Klima, Bevölkerung).</p>
      </section>

      <section class="pillar-stats">
        <h2>Geografie in Zahlen</h2>
        <ul>
          <li><strong>197</strong> anerkannte Länder auf der Welt (193 UN-Mitglieder + 4 Sonderfälle)</li>
          <li><strong>7</strong> Kontinente (Afrika, Nordamerika, Südamerika, Europa, Asien, Ozeanien, Antarktis)</li>
          <li><strong>~6.500</strong> Sprachen werden auf der Welt gesprochen</li>
          <li><strong>54</strong> Länder in Afrika, ein Viertel aller Länder der Erde</li>
          <li><strong>270.000</strong> Inseln in Schweden, mehr als in jedem anderen Land</li>
        </ul>
      </section>

      {sections.map(s => (
        <section class="pillar-sub">
          <h2>{s.title}</h2>
          <ul class="pillar-grid">
            {s.items.map(i => (
              <li><a href={`/de/blog/${i.post.data.urlSlug}/`}>{i.label}</a></li>
            ))}
          </ul>
        </section>
      ))}

      {moreArticles.length > 0 && (
        <section class="pillar-sub">
          <h2>Weitere Artikel</h2>
          <ul class="pillar-grid">
            {moreArticles.map(p => (
              <li><a href={`/de/blog/${p.data.urlSlug}/`}>{p.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="pillar-faq">
        <h2>Häufige Fragen zur Geografie</h2>

        <h3>Wie viele Länder gibt es auf der Welt?</h3>
        <p>Es gibt 197 anerkannte Länder auf der Welt: die 193 UN-Mitglieder plus Vatikanstadt, Palästina, Taiwan und Kosovo (je nach Anerkennung).</p>

        <h3>Was ist die Hauptstadt von Australien?</h3>
        <p>Die Hauptstadt Australiens ist Canberra, nicht Sydney und nicht Melbourne. Die Planstadt wurde 1913 gegründet, um die Rivalität zwischen Sydney und Melbourne zu beenden.</p>

        <h3>Welche Flaggen sind am schwersten zu erkennen?</h3>
        <p>Am häufigsten verwechselt werden Tschad und Rumänien (fast identisch), Monaco und Indonesien (Rot und Weiß vertauscht), die Slowakei und Slowenien (sehr ähnlich) sowie die nordischen Flaggen untereinander.</p>

        <h3>Welches ist das kleinste Land der Welt?</h3>
        <p>Die Vatikanstadt ist mit 0,49 km² und rund 825 Einwohnern das kleinste Land der Welt. Danach folgen Monaco (2,02 km²) und Nauru (21 km²).</p>

        <h3>Wie lernt man alle Länder der Welt?</h3>
        <p>Am effektivsten lernst du nach Kontinenten (nicht alphabetisch): Fang mit 30 wichtigen Ländern an und erweitere dann Schritt für Schritt. Fünfzehn Minuten Quiz pro Tag reichen, um dir die 197 Länder in 3 bis 6 Monaten einzuprägen.</p>
      </section>
    </article>
  </main>

  <Footer lang={lang} t={t} />
  <StickyMobileCta lang={lang} campaign="sticky-pillar" />
</Layout>

<style>
  .pillar-page { padding-top: 100px; padding-bottom: 60px; }
  .pillar-header { text-align: center; padding-bottom: 32px; margin-bottom: 32px; border-bottom: 1px solid var(--gris-clair); }
  .pillar-header h1 { font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 16px; }
  .lede { font-size: 1.25rem; color: var(--gris); max-width: 720px; margin: 0 auto; }
  .pillar-intro, .pillar-stats, .pillar-sub, .pillar-faq { max-width: 800px; margin: 0 auto 48px; }
  .pillar-intro p { line-height: 1.75; margin-bottom: 16px; font-size: 1.05rem; }
  .pillar-stats ul { padding-left: 24px; }
  .pillar-stats li { margin-bottom: 8px; line-height: 1.7; }
  .pillar-sub h2, .pillar-stats h2, .pillar-faq h2 { font-size: 1.75rem; margin-bottom: 20px; }
  .pillar-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .pillar-grid li { padding: 14px 18px; background: var(--gris-clair); border-radius: 8px; }
  .pillar-grid a { color: var(--noir); text-decoration: none; font-weight: 500; }
  .pillar-grid a:hover { color: var(--orange); }
  .pillar-faq h3 { font-size: 1.1rem; margin-top: 24px; margin-bottom: 8px; }
  .pillar-faq p { line-height: 1.7; margin-bottom: 16px; }
</style>
