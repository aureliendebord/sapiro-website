---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  fr: {
    title: "Joue comme tu veux",
    subtitle: "4 façons de jouer, dont les duels",
    modes: [
      {
        icon: "/images/v3/swords.webp",
        title: "Duel",
        description: "Affronte les vraies parties d'autres joueurs, question par question, et gagne des trophées. Personne sur ton thème ? Tu t'entraînes contre le bot Sapiro.",
        isNew: true
      },
      {
        icon: "/images/icons/quick-play.webp",
        title: "10 questions",
        description: "10 questions à la suite, sans filet. Le mode idéal pour découvrir un thème et progresser."
      },
      {
        icon: "/images/icons/heart.webp",
        title: "Record",
        description: "Tiens le plus longtemps possible : à la première erreur, c'est fini. Jusqu'où iras-tu ?"
      },
      {
        icon: "/images/icons/calendar.webp",
        title: "Défi du jour",
        description: "Un nouveau thème chaque jour, un seul essai. Garde ta série en vie !"
      }
    ]
  },
  en: {
    title: "Play your way",
    subtitle: "4 ways to play, duels included",
    modes: [
      {
        icon: "/images/v3/swords.webp",
        title: "Duel",
        description: "Take on other players' real games, question by question, and win trophies. Nobody on your topic yet? You practice against the Sapiro bot.",
        isNew: true
      },
      {
        icon: "/images/icons/quick-play.webp",
        title: "10 questions",
        description: "10 questions in a row, no safety net. The perfect mode to discover a topic and improve."
      },
      {
        icon: "/images/icons/heart.webp",
        title: "Record",
        description: "Last as long as you can: one mistake and it's over. How far can you go?"
      },
      {
        icon: "/images/icons/calendar.webp",
        title: "Daily Challenge",
        description: "A new topic every day, one try only. Keep your streak alive!"
      }
    ]
  },
  es: {
    title: "Juega a tu manera",
    subtitle: "4 maneras de jugar, duelos incluidos",
    modes: [
      {
        icon: "/images/v3/swords.webp",
        title: "Duelo",
        description: "Enfréntate a las partidas reales de otros jugadores, pregunta a pregunta, y gana trofeos. ¿Nadie en tu tema? Entrenas contra el bot Sapiro.",
        isNew: true
      },
      {
        icon: "/images/icons/quick-play.webp",
        title: "10 preguntas",
        description: "10 preguntas seguidas, sin red. El modo ideal para descubrir un tema y progresar."
      },
      {
        icon: "/images/icons/heart.webp",
        title: "Récord",
        description: "Aguanta lo máximo posible: al primer error, se acabó. ¿Hasta dónde llegarás?"
      },
      {
        icon: "/images/icons/calendar.webp",
        title: "Reto del día",
        description: "Un tema nuevo cada día, un solo intento. ¡Mantén viva tu racha!"
      }
    ]
  }
};

const newLabel = { fr: "Nouveau", en: "New", es: "Nuevo" }[lang];

const t = content[lang];

---

<section class="game-modes section">
  <div class="container">
    <div class="section-header">
      <h2>{t.title}</h2>
      <p class="section-subtitle">{t.subtitle}</p>
    </div>

    <div class="modes-grid">
      {t.modes.map((mode) => (
        <div class={`mode-card${mode.isNew ? ' mode-card--new' : ''}`}>
          {mode.isNew && <span class="mode-new">{newLabel}</span>}
          <div class="mode-emoji"><img src={mode.icon} class="mode-ico" alt="" aria-hidden="true" width="64" height="64" /></div>
          <h3>{mode.title}</h3>
          <p>{mode.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .game-modes {
    background: var(--gris-clair);
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-header h2 {
    margin-bottom: 16px;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--gris);
  }

  .modes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .mode-card {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.95);
    padding: 32px 24px;
    border-radius: var(--border-radius);
    text-align: center;
    box-shadow: var(--shadow);
    transition: transform 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .mode-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .mode-emoji {
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
  }

  .mode-ico {
    width: 64px;
    height: 64px;
    object-fit: contain;
    filter: drop-shadow(0 6px 10px rgba(120, 50, 20, 0.18));
  }

  /* Le duel, nouveauté 2.1.0 : liseré orange et pastille « Nouveau » */
  .mode-card--new {
    background: linear-gradient(180deg, #fff 0%, #FFF3EC 100%);
    border: 2px solid rgba(255, 94, 58, 0.45);
  }

  .mode-new {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
  }

  .mode-card h3 {
    margin-bottom: 12px;
    color: var(--noir);
    font-size: 1.25rem;
  }

  .mode-card p {
    color: var(--gris);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  @media (max-width: 1100px) {
    .modes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .modes-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
