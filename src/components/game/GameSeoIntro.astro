---
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * Contenu rendu au build, sous le jeu.
 *
 * Le jeu est monté en `client:only` : sans ce bloc, /jouer est une page vide
 * pour Google et pour un visiteur sans JavaScript. Le texte décrit les modes
 * — c'est aussi ce qui répond à « on ne voit pas les modes de jeu » pour
 * quelqu'un qui arrive par une recherche.
 *
 * Volontairement distinct de GameModes.astro (home) : deux pages du même site
 * qui décrivent la même chose se cannibalisent.
 */
const copy = {
  fr: {
    title: 'Le quiz Sapiro, jouable directement dans ton navigateur',
    intro:
      "Aucune installation, aucun compte obligatoire : tu joues, et ta progression te suit si tu crées un compte. Le même jeu que l'application mobile, avec les mêmes questions vérifiées et les mêmes images.",
    modesTitle: 'Cinq façons de jouer',
    modes: [
      ['Aventure', "Un sentier de 54 blocs qui traverse la géographie, l'histoire, l'art, la nature et les monuments. Chaque étape se débloque en réussissant la précédente."],
      ['Défi du jour', "Dix questions, les mêmes pour tous les joueurs du monde ce jour-là. Il ne consomme aucune de tes parties quotidiennes."],
      ['Partie rapide', 'Dix questions tirées au hasard pour une session courte.'],
      ['Survie', "Trois vies, aucune limite de questions : le mode qui dit vraiment ce que tu sais."],
      ['Révision', "Rejoue uniquement les questions que tu as ratées, jusqu'à ce qu'elles rentrent."],
    ],
    appTitle: 'Et sur mobile ?',
    appText:
      "L'application iOS et Android propose le même jeu hors connexion, avec les notifications du défi quotidien. Ton compte relie les deux : commence sur le web, continue sur ton téléphone.",
  },
  en: {
    title: 'The Sapiro quiz, playable right in your browser',
    intro:
      'No install, no mandatory account: you play, and your progress follows you if you create one. The same game as the mobile app, with the same fact-checked questions and images.',
    modesTitle: 'Five ways to play',
    modes: [
      ['Adventure', 'A 54-block trail across geography, history, art, nature and monuments. Each stage unlocks by clearing the previous one.'],
      ['Daily Challenge', 'Ten questions, the same for every player in the world that day. It never uses up your daily games.'],
      ['Quick game', 'Ten random questions for a short session.'],
      ['Survival', 'Three lives, no question limit: the mode that really shows what you know.'],
      ['Review', 'Replay only the questions you got wrong, until they stick.'],
    ],
    appTitle: 'What about mobile?',
    appText:
      'The iOS and Android app offers the same game offline, with daily challenge notifications. Your account links both: start on the web, continue on your phone.',
  },
  es: {
    title: 'El quiz de Sapiro, jugable directamente en tu navegador',
    intro:
      'Sin instalación, sin cuenta obligatoria: juegas, y tu progreso te acompaña si creas una. El mismo juego que la app móvil, con las mismas preguntas verificadas y las mismas imágenes.',
    modesTitle: 'Cinco maneras de jugar',
    modes: [
      ['Aventura', 'Un sendero de 54 bloques por geografía, historia, arte, naturaleza y monumentos. Cada etapa se desbloquea superando la anterior.'],
      ['Desafío del día', 'Diez preguntas, las mismas para todos los jugadores del mundo ese día. Nunca gasta tus partidas diarias.'],
      ['Partida rápida', 'Diez preguntas al azar para una sesión corta.'],
      ['Supervivencia', 'Tres vidas, sin límite de preguntas: el modo que dice de verdad lo que sabes.'],
      ['Repaso', 'Vuelve a jugar solo las preguntas que fallaste, hasta que se queden.'],
    ],
    appTitle: '¿Y en el móvil?',
    appText:
      'La app de iOS y Android ofrece el mismo juego sin conexión, con notificaciones del desafío diario. Tu cuenta enlaza ambos: empieza en la web, sigue en tu teléfono.',
  },
} as const;

const t = copy[lang];
---

<section class="game-seo">
  <h1>{t.title}</h1>
  <p>{t.intro}</p>

  <h2>{t.modesTitle}</h2>
  <dl>
    {t.modes.map(([name, desc]) => (
      <>
        <dt>{name}</dt>
        <dd>{desc}</dd>
      </>
    ))}
  </dl>

  <h2>{t.appTitle}</h2>
  <p>{t.appText}</p>
</section>

<style>
  .game-seo h1 {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.4px;
    color: var(--noir);
    margin: 0 0 12px;
  }

  .game-seo h2 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--noir);
    margin: 28px 0 10px;
  }

  .game-seo p {
    max-width: 68ch;
    line-height: 1.65;
    margin: 0;
  }

  .game-seo dl {
    max-width: 68ch;
    margin: 0;
  }

  .game-seo dt {
    font-weight: 800;
    color: var(--noir);
    margin-top: 14px;
  }

  .game-seo dd {
    margin: 4px 0 0;
    line-height: 1.6;
  }
</style>
