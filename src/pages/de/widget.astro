---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WidgetPage from '../../components/WidgetPage.astro';
import { getTranslations } from '../../i18n';

const lang = 'de';
const t = getTranslations(lang);
---

<Layout title="Kostenloses Geografie-Quiz-Widget für deine Website | SAPIRO" description="Bau ein Flaggen- oder Hauptstadt-Quiz in deine Website oder deinen virtuellen Klassenraum ein: kostenlos, ohne Werbung, ohne Cookies. Einfach kopieren und einfügen." lang={lang}>
  <Header lang={lang} t={t} />

  <main class="page-main">
    <WidgetPage lang={lang} />
  </main>

  <Footer lang={lang} t={t} />
</Layout>
