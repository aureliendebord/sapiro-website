---
import '../styles/global.css';
import { getHreflangUrls } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  lang?: string;
  noDefaultHreflang?: boolean;
  noCanonical?: boolean;
  canonicalOverride?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const { title, description, lang = 'fr', noDefaultHreflang = false, noCanonical = false, canonicalOverride, ogType = 'website', ogImage, ogImageAlt, ogImageWidth, ogImageHeight } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const canonicalHref = canonicalOverride || canonicalURL.toString();
// || et non ?? : une chaîne vide doit retomber sur le visuel par défaut
// Visuels OG par défaut disponibles (pas encore d'allemand : repli anglais).
const DEFAULT_OG_LANGS = ['fr', 'en', 'es'];
const ogDefaultLang = DEFAULT_OG_LANGS.includes(lang) ? lang : 'en';
const ogImageURL = new URL(ogImage || `/images/og/default-${ogDefaultLang}.png`, Astro.site);

// Build hreflang URLs using the centralized route map (handles slug translations).
// Seules les versions qui existent sont annoncées : l'allemand n'a pas toutes
// les pages (pas de concours, famille, comparatifs).
const pathname = Astro.url.pathname;
const routeUrls = getHreflangUrls(pathname);

let hreflangLinks: Array<{ lang: string; href: string }>;

if (routeUrls) {
  hreflangLinks = routeUrls.map((r) => ({ lang: r.lang, href: `https://sapiro.app${r.path}` }));
} else if (pathname.startsWith('/de/')) {
  // Page allemande hors table : pas d'équivalent connu dans les autres langues.
  hreflangLinks = [];
} else {
  // Fallback for unmapped pages (e.g., blog posts that pass noDefaultHreflang)
  const basePath = pathname.replace(/^\/(en|es)(?=\/)/, '');
  hreflangLinks = [
    { lang: 'fr', href: `https://sapiro.app${basePath}` },
    { lang: 'en', href: `https://sapiro.app/en${basePath}` },
    { lang: 'es', href: `https://sapiro.app/es${basePath}` },
  ];
}
const xDefaultLink = hreflangLinks.find((h) => h.lang === 'fr') ?? hreflangLinks[0];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="SAPIRO" />

  <!-- Smart App Banner (Safari iOS) -->
  <meta name="apple-itunes-app" content="app-id=6757706883" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="180x180" href="/images/icon-180.png" />
  <link rel="apple-touch-icon" href="/images/icon-180.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.toString()} />
  {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
  {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
  {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.toString()} />

  <!-- Canonical -->
  {!noCanonical && <link rel="canonical" href={canonicalHref} />}

  <!-- Alternate languages (dynamic per page) -->
  {!noDefaultHreflang && (
    <>
      {hreflangLinks.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
      {xDefaultLink && <link rel="alternate" hreflang="x-default" href={xDefaultLink.href} />}
    </>
  )}

  <!-- Polices de l'app (DA V3), auto-hébergées : voir global.css -->
  <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />

  <title>{title}</title>
  <slot name="head" />

  <!-- Analytics -->
  <script defer src="https://trafic.debord.eu/script.js" data-website-id="32b4fd6e-17a1-465a-b2ee-fe09c0f6dad7"></script>
  <script>
    // PostHog sur tout le site, pas seulement /jouer : c'est ce qui permet de
    // relier un joueur à sa page d'arrivée et à sa source (referrer, utm_*).
    import { initAnalytics } from '../lib/posthog';
    initAnalytics();
  </script>
</head>
<body>
  <slot />
</body>
</html>
