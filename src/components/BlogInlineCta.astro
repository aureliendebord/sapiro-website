---
import type { Lang } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * DA calquée sur les bannières des fiches stores (screenshots/ios-framed
 * du repo de l'app) : fond cream→pêche, badge pingouin cerclé blanc, titre
 * Nunito ExtraBold avec un mot surligné pêche légèrement incliné, sparkles,
 * et un iPhone incliné à droite, à moitié cropé, qui fait défiler les vrais
 * screens in-game localisés (pattern repris du mockup de la home).
 */
const copy: Record<Lang, { titleBefore: string; titleHl: string; sub: string; xpAmount: string; xpLabel: string }> = {
  fr: {
    titleBefore: 'Apprends',
    titleHl: 'en jouant',
    sub: 'Drapeaux, tableaux, animaux… 2 000+ quiz photo. Gratuit, sans pub.',
    xpAmount: '+120 XP',
    xpLabel: 'Série de 5',
  },
  en: {
    titleBefore: 'Learn',
    titleHl: 'by playing',
    sub: 'Flags, paintings, animals… 2,000+ photo quizzes. Free, no ads.',
    xpAmount: '+120 XP',
    xpLabel: '5-streak',
  },
  es: {
    titleBefore: 'Aprende',
    titleHl: 'jugando',
    sub: 'Banderas, cuadros, animales… 2 000+ quiz con fotos. Gratis, sin anuncios.',
    xpAmount: '+120 XP',
    xpLabel: 'Racha de 5',
  },
};

const t = copy[lang];

const slides = ['01', '02', '03', '04', '05'].map(n => `/images/banner/screen-${lang}-${n}.webp`);
---

<template id="inline-cta-template">
  <aside class="inline-cta">
    <span class="sparkle s1" aria-hidden="true">✦</span>
    <span class="sparkle s2" aria-hidden="true">✦</span>
    <span class="sparkle s3" aria-hidden="true">✦</span>

    <div class="cta-text">
      <p class="cta-title">
        {t.titleBefore}&nbsp;<span class="hl">{t.titleHl}</span>
      </p>
      <p class="cta-sub">{t.sub}</p>
    </div>

    <div class="cta-stage" aria-hidden="true">
      <div class="glow"></div>
      <div class="phone-tilt">
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            {slides.map((src, i) => (
              <img src={src} alt="" class={`slide slide-${i + 1}`} width="460" height="1000" loading="lazy" />
            ))}
          </div>
        </div>
      </div>
      <div class="floating-card card-top">
        <div class="card-emoji"><img src="/images/icons/lightning.webp" class="app-ico" alt="" aria-hidden="true" /></div>
        <div class="card-content">
          <div class="card-num">{t.xpAmount}</div>
          <div class="card-label">{t.xpLabel}</div>
        </div>
      </div>
    </div>

    <div class="cta-stores">
      <a href={appStoreUrl(lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
        App Store
      </a>
      <a href={playStoreUrl('inline-banner', lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>
        Google Play
      </a>
    </div>
  </aside>
</template>

<script is:inline>
(() => {
  const template = document.getElementById('inline-cta-template');
  const content = document.getElementById('article-content');
  if (!template || !content) return;

  const headings = content.querySelectorAll('h2');
  if (headings.length < 4) return;

  headings[2].parentNode.insertBefore(template.content.cloneNode(true), headings[2]);
})();
</script>

<style>
  @font-face {
    font-family: 'Nunito Banner';
    src: url('/fonts/nunito-800-subset.woff2') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  .inline-cta {
    position: relative;
    display: block;
    min-height: 380px;
    margin: 88px 0 76px;
    padding: 36px 300px 36px 32px;
    background:
      radial-gradient(120% 100% at 90% 110%, rgba(255, 145, 61, 0.32), transparent 60%),
      linear-gradient(165deg, #FBF3E7, #F7E3CA);
    border-radius: var(--border-radius);
  }

  /* --- Sparkles --- */
  .sparkle {
    position: absolute;
    color: #F1913D;
    font-size: 18px;
    line-height: 1;
    animation: sparkle-twinkle 2.8s ease-in-out infinite;
    pointer-events: none;
  }

  .s1 { top: 18px; left: 42%; }
  .s2 { top: 44px; right: 18px; font-size: 12px; animation-delay: 0.9s; }
  .s3 { bottom: 22px; left: 20px; font-size: 13px; animation-delay: 1.8s; }

  @keyframes sparkle-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }

  .cta-title {
    font-family: 'Nunito Banner', var(--font-family);
    font-size: 2rem;
    font-weight: 800;
    color: #3D2B1F;
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .cta-title .hl {
    display: inline-block;
    background: linear-gradient(100deg, #F9CD9E, #F6BE85);
    border-radius: 10px;
    padding: 0 10px 2px;
    transform: rotate(-2deg);
  }

  .cta-sub {
    font-size: 0.95rem;
    color: #85705C;
    line-height: 1.55;
    margin: 0 0 4px;
    max-width: 340px;
  }

  /* --- Mockup iPhone : réplique du phone-stage de la home (HeroV2) --- */
  .cta-stage {
    position: absolute;
    top: -44px;
    right: 44px;
    width: 230px;
    z-index: 2;
  }

  .glow {
    position: absolute;
    top: 70px;
    left: -6px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.28), transparent 70%);
    filter: blur(60px);
    animation: glowFloat 6s ease-in-out infinite;
  }

  @keyframes glowFloat {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(20px, -15px); }
  }

  .phone-tilt {
    transform: perspective(1400px) rotateY(-14deg) rotateX(6deg) rotateZ(-2deg);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 40px 60px rgba(120, 70, 20, 0.4));
  }

  .cta-stage:hover .phone-tilt {
    transform: perspective(1400px) rotateY(-8deg) rotateX(3deg) rotateZ(-1deg);
  }

  .phone {
    position: relative;
    width: 230px;
    height: 470px;
    background: #0a0a0a;
    border-radius: 40px;
    padding: 9px;
    border: 2px solid #1f1f1f;
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.05),
      0 0 0 8px rgba(255, 255, 255, 0.03);
  }

  .phone-notch {
    position: absolute;
    top: 13px;
    left: 50%;
    transform: translateX(-50%);
    width: 76px;
    height: 21px;
    background: #0a0a0a;
    border-radius: 12px;
    z-index: 2;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 32px;
    overflow: hidden;
    background: #FAF6F0;
  }

  .phone-screen .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    margin: 0;
    box-shadow: none;
    border-radius: 0;
    opacity: 0;
    animation: slideShow 20s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .phone-screen .slide-1 { opacity: 1; animation-delay: 0s; }
  .phone-screen .slide-2 { animation-delay: 4s; }
  .phone-screen .slide-3 { animation-delay: 8s; }
  .phone-screen .slide-4 { animation-delay: 12s; }
  .phone-screen .slide-5 { animation-delay: 16s; }

  @keyframes slideShow {
    0% { opacity: 0; transform: translateX(8%) scale(1.02); }
    2% { opacity: 1; transform: translateX(0) scale(1); }
    18% { opacity: 1; transform: translateX(0) scale(1); }
    22% { opacity: 0; transform: translateX(-8%) scale(1.02); }
    100% { opacity: 0; transform: translateX(8%) scale(1.02); }
  }

  .floating-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.98);
    color: #1f2937;
    border-radius: 14px;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4);
    z-index: 3;
  }

  .card-top {
    top: 12%;
    right: -24px;
    animation: floatCardTop 5s ease-in-out infinite;
  }

  @keyframes floatCardTop {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-10px) rotate(1.5deg); }
  }

  .card-emoji {
    font-size: 22px;
    animation: emojiPulse 2.4s ease-in-out infinite;
  }

  @keyframes emojiPulse {
    0%, 100% { transform: scale(1) rotate(0deg); filter: brightness(1); }
    50% { transform: scale(1.18) rotate(-6deg); filter: brightness(1.2) drop-shadow(0 0 8px rgba(255, 191, 36, 0.6)); }
  }

  .card-num { font-size: 14px; font-weight: 700; }
  .card-label { font-size: 11px; color: #6b7280; }

  /* --- Boutons stores --- */
  .cta-stores {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .inline-cta .store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #33241A;
    color: #fff;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 22px -10px rgba(61, 43, 31, 0.55);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .inline-cta .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -10px rgba(61, 43, 31, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkle, .glow, .floating-card, .card-emoji {
      animation-duration: 60s !important;
    }
  }

  @media (max-width: 640px) {
    .inline-cta {
      min-height: 0;
      padding: 24px 18px 28px;
    }

    .cta-title { font-size: 1.55rem; }

    .cta-sub { max-width: none; }

    .inline-cta { margin: 48px 0; }

    .cta-stage {
      position: relative;
      top: 0;
      right: 0;
      width: 100%;
      height: auto;
      margin: 20px 0 8px;
      display: flex;
      justify-content: center;
    }

    .glow { left: 50%; margin-left: -130px; }

    .phone { flex-shrink: 0; }

    .card-top { right: 6px; }

    .cta-stores { justify-content: center; margin-top: 10px; }
  }
</style>
