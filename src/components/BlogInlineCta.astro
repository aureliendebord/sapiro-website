---
import type { Lang } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * DA calquée sur les bannières des fiches stores (screenshots/ios-framed
 * du repo de l'app) : fond cream→pêche, badge pingouin cerclé blanc, titre
 * chunky brun avec un mot surligné pêche, sparkles orange, et une mini-démo
 * du quiz qui joue toute seule en boucle (3 scènes, la bonne réponse
 * s'allume) — l'effet vidéo, sans le poids d'une vidéo.
 */
const copy: Record<Lang, {
  titleBefore: string; titleHl: string;
  sub: string;
  scenes: { kicker: string; question: string; wrong: string; right: string }[];
}> = {
  fr: {
    titleBefore: 'Apprends',
    titleHl: 'en jouant',
    sub: 'Drapeaux, tableaux, animaux… 2 000+ quiz photo. Gratuit, sans pub.',
    scenes: [
      { kicker: 'Drapeaux', question: 'Quel est ce pays ?', wrong: 'Chine', right: 'Japon' },
      { kicker: 'Tableaux', question: 'Qui l\'a peinte ?', wrong: 'Monet', right: 'De Vinci' },
      { kicker: 'Animaux', question: 'Quel est cet animal ?', wrong: 'Léopard', right: 'Guépard' },
    ],
  },
  en: {
    titleBefore: 'Learn',
    titleHl: 'by playing',
    sub: 'Flags, paintings, animals… 2,000+ photo quizzes. Free, no ads.',
    scenes: [
      { kicker: 'Flags', question: 'Which country is this?', wrong: 'China', right: 'Japan' },
      { kicker: 'Paintings', question: 'Who painted it?', wrong: 'Monet', right: 'Da Vinci' },
      { kicker: 'Animals', question: 'Which animal is this?', wrong: 'Leopard', right: 'Cheetah' },
    ],
  },
  es: {
    titleBefore: 'Aprende',
    titleHl: 'jugando',
    sub: 'Banderas, cuadros, animales… 2 000+ quiz con fotos. Gratis, sin anuncios.',
    scenes: [
      { kicker: 'Banderas', question: '¿Qué país es?', wrong: 'China', right: 'Japón' },
      { kicker: 'Cuadros', question: '¿Quién lo pintó?', wrong: 'Monet', right: 'Da Vinci' },
      { kicker: 'Animales', question: '¿Qué animal es?', wrong: 'Leopardo', right: 'Guepardo' },
    ],
  },
};

const t = copy[lang];

const sceneImages = [
  { src: '/images/banner/jp.png', fit: 'contain' },
  { src: '/images/banner/joconde.webp', fit: 'cover' },
  { src: '/images/banner/guepard.webp', fit: 'cover' },
];
---

<template id="inline-cta-template">
  <aside class="inline-cta">
    <span class="sparkle s1" aria-hidden="true">✦</span>
    <span class="sparkle s2" aria-hidden="true">✦</span>
    <span class="sparkle s3" aria-hidden="true">✦</span>

    <div class="cta-text">
      <div class="cta-badge">
        <img src="/images/icon-180.png" alt="SAPIRO" width="52" height="52" loading="lazy" />
      </div>
      <p class="cta-title">
        {t.titleBefore}&nbsp;<span class="hl">{t.titleHl}</span>
      </p>
      <p class="cta-sub">{t.sub}</p>
    </div>

    <div class="cta-quiz" role="img" aria-label="SAPIRO">
      {t.scenes.map((scene, i) => (
        <div class={`scene scene-${i + 1}`}>
          <span class="scene-kicker">{scene.kicker}</span>
          <p class="scene-question">{scene.question}</p>
          <div class={`scene-img img-${sceneImages[i].fit}`}>
            <img src={sceneImages[i].src} alt="" width="240" height="96" loading="lazy" />
          </div>
          <div class="scene-chips">
            <span class="chip">{scene.wrong}</span>
            <span class="chip chip-right">{scene.right}</span>
          </div>
        </div>
      ))}
      <div class="quiz-progress" aria-hidden="true"><span></span></div>
    </div>

    <div class="cta-stores">
      <a href={appStoreUrl(lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
        App Store
      </a>
      <a href={playStoreUrl('inline-banner', lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>
        Google Play
      </a>
    </div>
  </aside>
</template>

<script is:inline>
(() => {
  const template = document.getElementById('inline-cta-template');
  const content = document.getElementById('article-content');
  if (!template || !content) return;

  const headings = content.querySelectorAll('h2');
  if (headings.length < 4) return;

  headings[2].parentNode.insertBefore(template.content.cloneNode(true), headings[2]);
})();
</script>

<style>
  .inline-cta {
    position: relative;
    display: grid;
    grid-template-areas:
      'text quiz'
      'stores quiz';
    grid-template-columns: 1fr 236px;
    align-items: center;
    gap: 8px 32px;
    margin: 40px 0;
    padding: 28px 32px;
    background:
      radial-gradient(120% 100% at 90% 110%, rgba(255, 145, 61, 0.32), transparent 60%),
      linear-gradient(165deg, #FBF3E7, #F7E3CA);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  /* --- Sparkles --- */
  .sparkle {
    position: absolute;
    color: #F1913D;
    font-size: 18px;
    line-height: 1;
    animation: sparkle-twinkle 2.8s ease-in-out infinite;
    pointer-events: none;
  }

  .s1 { top: 18px; left: 42%; }
  .s2 { top: 44px; right: 18px; font-size: 12px; animation-delay: 0.9s; }
  .s3 { bottom: 22px; left: 20px; font-size: 13px; animation-delay: 1.8s; }

  @keyframes sparkle-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }

  /* --- Texte --- */
  .cta-text {
    grid-area: text;
  }

  .cta-badge {
    display: inline-flex;
    padding: 4px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 6px 16px -6px rgba(120, 70, 20, 0.35);
    margin-bottom: 14px;
  }

  .cta-badge img,
  .scene-img img {
    margin: 0;
    box-shadow: none;
  }

  .cta-badge img {
    border-radius: 50%;
  }

  .cta-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #3D2B1F;
    line-height: 1.2;
    margin: 0 0 8px;
  }

  .cta-title .hl {
    background: linear-gradient(100deg, #F9CD9E, #F6BE85);
    border-radius: 10px;
    padding: 1px 10px 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .cta-sub {
    font-size: 0.95rem;
    color: #85705C;
    line-height: 1.55;
    margin: 0 0 4px;
    max-width: 340px;
  }

  /* --- Mini quiz animé --- */
  .cta-quiz {
    grid-area: quiz;
    position: relative;
    height: 218px;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 18px 36px -14px rgba(120, 70, 20, 0.35);
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    opacity: 0;
    animation: scene-cycle 9s infinite;
  }

  .scene-1 { animation-delay: 0s; }
  .scene-2 { animation-delay: 3s; }
  .scene-3 { animation-delay: 6s; }

  @keyframes scene-cycle {
    0% { opacity: 0; transform: translateY(6px); }
    4%, 30% { opacity: 1; transform: translateY(0); }
    33.33%, 100% { opacity: 0; transform: translateY(-4px); }
  }

  .scene-kicker {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--orange);
  }

  .scene-question {
    font-size: 0.92rem;
    font-weight: 700;
    color: #3D2B1F;
    margin: 2px 0 8px;
  }

  .scene-img {
    height: 88px;
    border-radius: 12px;
    overflow: hidden;
    background: #FAF6F0;
    margin-bottom: 10px;
  }

  .scene-img img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .img-cover img { object-fit: cover; }
  .img-contain img { object-fit: contain; padding: 6px; }

  .scene-chips {
    display: flex;
    gap: 8px;
  }

  .chip {
    flex: 1;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    color: #3D2B1F;
    background: #fff;
    border: 1.5px solid #EBDDCB;
    border-radius: 10px;
    padding: 8px 4px;
  }

  .chip-right {
    animation: chip-flash 9s infinite;
    animation-delay: inherit;
  }

  .scene-1 .chip-right { animation-delay: 0s; }
  .scene-2 .chip-right { animation-delay: 3s; }
  .scene-3 .chip-right { animation-delay: 6s; }

  @keyframes chip-flash {
    0%, 15% { background: #fff; color: #3D2B1F; border-color: #EBDDCB; transform: scale(1); }
    19%, 30% { background: var(--orange); color: #fff; border-color: var(--orange); transform: scale(1.04); }
    33.33%, 100% { background: #fff; color: #3D2B1F; border-color: #EBDDCB; transform: scale(1); }
  }

  .quiz-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 18px 18px 0 0;
    background: #F3E7D7;
    overflow: hidden;
  }

  .quiz-progress span {
    display: block;
    height: 100%;
    background: var(--orange);
    transform-origin: left;
    animation: quiz-progress 3s linear infinite;
  }

  @keyframes quiz-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* --- Boutons stores --- */
  .cta-stores {
    grid-area: stores;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-self: start;
    margin-top: 10px;
  }

  .inline-cta .store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #33241A;
    color: #fff;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 22px -10px rgba(61, 43, 31, 0.55);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .inline-cta .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -10px rgba(61, 43, 31, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkle, .quiz-progress span { animation: none; }
    .scene { animation: none; }
    .scene-2, .scene-3 { display: none; }
    .scene-1 { opacity: 1; }
    .chip-flash, .scene-1 .chip-right { animation: none; background: var(--orange); color: #fff; border-color: var(--orange); }
  }

  @media (max-width: 640px) {
    .inline-cta {
      grid-template-areas:
        'text'
        'quiz'
        'stores';
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 24px 18px;
    }

    .cta-title { font-size: 1.45rem; }

    .cta-quiz {
      width: 100%;
      max-width: 300px;
      justify-self: center;
    }

    .cta-stores { justify-content: center; margin-top: 0; }
  }
</style>
