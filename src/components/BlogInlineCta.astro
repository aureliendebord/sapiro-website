---
import type { Lang } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * DA calquée sur les bannières des fiches stores (screenshots/ios-framed
 * du repo de l'app) : fond cream→pêche, badge pingouin cerclé blanc, titre
 * Nunito ExtraBold avec un mot surligné pêche légèrement incliné, sparkles,
 * et un iPhone incliné à droite, à moitié cropé, qui fait défiler les vrais
 * screens in-game localisés (pattern repris du mockup de la home).
 */
const copy: Record<Lang, { titleBefore: string; titleHl: string; sub: string }> = {
  fr: {
    titleBefore: 'Apprends',
    titleHl: 'en jouant',
    sub: 'Drapeaux, tableaux, animaux… 2 000+ quiz photo. Gratuit, sans pub.',
  },
  en: {
    titleBefore: 'Learn',
    titleHl: 'by playing',
    sub: 'Flags, paintings, animals… 2,000+ photo quizzes. Free, no ads.',
  },
  es: {
    titleBefore: 'Aprende',
    titleHl: 'jugando',
    sub: 'Banderas, cuadros, animales… 2 000+ quiz con fotos. Gratis, sin anuncios.',
  },
};

const t = copy[lang];

const slides = ['01', '03', '04'].map(n => `/images/banner/screen-${lang}-${n}.webp`);
---

<template id="inline-cta-template">
  <aside class="inline-cta">
    <span class="sparkle s1" aria-hidden="true">✦</span>
    <span class="sparkle s2" aria-hidden="true">✦</span>
    <span class="sparkle s3" aria-hidden="true">✦</span>

    <div class="cta-text">
      <div class="cta-badge">
        <img src="/images/icon-180.png" alt="SAPIRO" width="52" height="52" loading="lazy" />
      </div>
      <p class="cta-title">
        {t.titleBefore}&nbsp;<span class="hl">{t.titleHl}</span>
      </p>
      <p class="cta-sub">{t.sub}</p>
    </div>

    <div class="cta-phone" aria-hidden="true">
      <div class="phone">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          {slides.map((src, i) => (
            <img src={src} alt="" class={`slide slide-${i + 1}`} width="300" height="652" loading="lazy" />
          ))}
        </div>
      </div>
    </div>

    <div class="cta-stores">
      <a href={appStoreUrl(lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
        App Store
      </a>
      <a href={playStoreUrl('inline-banner', lang)} class="store" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>
        Google Play
      </a>
    </div>
  </aside>
</template>

<script is:inline>
(() => {
  const template = document.getElementById('inline-cta-template');
  const content = document.getElementById('article-content');
  if (!template || !content) return;

  const headings = content.querySelectorAll('h2');
  if (headings.length < 4) return;

  headings[2].parentNode.insertBefore(template.content.cloneNode(true), headings[2]);
})();
</script>

<style>
  @font-face {
    font-family: 'Nunito Banner';
    src: url('/fonts/nunito-800-subset.woff2') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  .inline-cta {
    position: relative;
    display: block;
    min-height: 330px;
    margin: 40px 0;
    padding: 32px 250px 32px 32px;
    background:
      radial-gradient(120% 100% at 90% 110%, rgba(255, 145, 61, 0.32), transparent 60%),
      linear-gradient(165deg, #FBF3E7, #F7E3CA);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  /* --- Sparkles --- */
  .sparkle {
    position: absolute;
    color: #F1913D;
    font-size: 18px;
    line-height: 1;
    animation: sparkle-twinkle 2.8s ease-in-out infinite;
    pointer-events: none;
  }

  .s1 { top: 18px; left: 42%; }
  .s2 { top: 44px; right: 18px; font-size: 12px; animation-delay: 0.9s; }
  .s3 { bottom: 22px; left: 20px; font-size: 13px; animation-delay: 1.8s; }

  @keyframes sparkle-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(20deg); }
  }

  .cta-badge {
    display: inline-flex;
    padding: 4px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 6px 16px -6px rgba(120, 70, 20, 0.35);
    margin-bottom: 14px;
  }

  .cta-badge img {
    margin: 0;
    box-shadow: none;
    border-radius: 50%;
  }

  .cta-title {
    font-family: 'Nunito Banner', var(--font-family);
    font-size: 2rem;
    font-weight: 800;
    color: #3D2B1F;
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .cta-title .hl {
    display: inline-block;
    background: linear-gradient(100deg, #F9CD9E, #F6BE85);
    border-radius: 10px;
    padding: 0 10px 2px;
    transform: rotate(-2deg);
  }

  .cta-sub {
    font-size: 0.95rem;
    color: #85705C;
    line-height: 1.55;
    margin: 0 0 4px;
    max-width: 340px;
  }

  /* --- iPhone incliné, screens qui défilent --- */
  .cta-phone {
    position: absolute;
    top: 30px;
    right: -26px;
    width: 220px;
    animation: phone-float 5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes phone-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .phone {
    position: relative;
    width: 200px;
    height: 410px;
    background: #0a0a0a;
    border-radius: 36px;
    padding: 8px;
    border: 2px solid #1f1f1f;
    transform: rotate(9deg);
    box-shadow:
      inset 0 0 0 2px rgba(255, 255, 255, 0.05),
      0 24px 48px -16px rgba(120, 70, 20, 0.45);
  }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 20px;
    background: #0a0a0a;
    border-radius: 12px;
    z-index: 2;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #FAF6F0;
  }

  .phone-screen .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    margin: 0;
    box-shadow: none;
    border-radius: 0;
    opacity: 0;
    animation: slide-cycle 9s infinite;
  }

  .slide-1 { animation-delay: 0s; }
  .slide-2 { animation-delay: 3s; }
  .slide-3 { animation-delay: 6s; }

  @keyframes slide-cycle {
    0% { opacity: 0; }
    5%, 32% { opacity: 1; }
    38%, 100% { opacity: 0; }
  }

  /* --- Boutons stores --- */
  .cta-stores {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .inline-cta .store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #33241A;
    color: #fff;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 22px -10px rgba(61, 43, 31, 0.55);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .inline-cta .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -10px rgba(61, 43, 31, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .sparkle, .cta-phone { animation: none; }
    .phone-screen .slide { animation: none; }
    .phone-screen .slide-2, .phone-screen .slide-3 { display: none; }
    .phone-screen .slide-1 { opacity: 1; }
  }

  @media (max-width: 640px) {
    .inline-cta {
      min-height: 0;
      padding: 24px 18px 28px;
    }

    .cta-title { font-size: 1.55rem; }

    .cta-sub { max-width: none; }

    .cta-phone {
      position: relative;
      top: 0;
      right: 0;
      width: 100%;
      height: 250px;
      margin: 18px 0 4px;
      display: flex;
      justify-content: center;
      overflow: hidden;
    }

    .phone {
      flex-shrink: 0;
      transform: rotate(8deg) translateX(10px);
    }

    .cta-stores { justify-content: center; margin-top: 10px; }
  }
</style>
