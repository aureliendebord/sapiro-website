---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WidgetPage from '../components/WidgetPage.astro';
import { getTranslations } from '../i18n';

const lang = 'fr';
const t = getTranslations(lang);
---

<Layout title="Widget quiz de géographie gratuit pour votre site | SAPIRO" description="Intégrez un quiz drapeaux ou capitales sur votre site ou votre ENT : gratuit, sans publicité, sans cookie. Un copier-coller suffit." lang={lang}>
  <Header lang={lang} t={t} />

  <main class="page-main">
    <WidgetPage lang={lang} />
  </main>

  <Footer lang={lang} t={t} />
</Layout>
