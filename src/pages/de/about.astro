---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AboutV2 from '../../components/v2/AboutV2.astro';
import DownloadV2 from '../../components/v2/DownloadV2.astro';
import StickyMobileCta from '../../components/v2/StickyMobileCta.astro';
import { getTranslations } from '../../i18n';

const lang = 'de';
const t = getTranslations(lang);
---

<Layout title="Über SAPIRO - Aurélien Debord" description="SAPIRO wird von Aurélien Debord herausgegeben, dem Gründer von Agence Debord. Hochwertige Lerninhalte, ohne Werbung." lang={lang}>
  <Header lang={lang} t={t} />

  <main class="page-main">
    <AboutV2 lang={lang} />
    <DownloadV2 lang={lang} />
  </main>

  <Footer lang={lang} t={t} />
  <StickyMobileCta lang={lang} />
</Layout>
