---
import type { Lang } from '../../i18n';
import QRCode from 'qrcode';
import { appStoreUrl, playStoreUrl } from '../../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * Passerelle vers l'app, posée JUSTE sous le jeu — avant le contenu SEO.
 *
 * Le joueur qui vient de finir une partie est au meilleur moment pour
 * installer l'app ; jusqu'ici il tombait d'abord sur trois écrans de texte
 * d'optimisation, et les liens stores n'arrivaient qu'en pied de page. Le QR
 * code sert le cas dominant : on joue sur ordinateur, on installe sur son
 * téléphone — sans avoir à retaper l'adresse.
 */
const qrTarget = 'https://sapiro.app';
const qrSvg = await QRCode.toString(qrTarget, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#1a1816', light: '#ffffff' },
});

const copy = {
  fr: {
    kicker: 'Continue sur ton téléphone',
    title: 'Le même jeu, dans ta poche',
    text: "Ton compte relie les deux : la progression, les badges et la série du Défi du jour te suivent. L'app ajoute la notification du défi quotidien, pour ne plus le rater.",
    scan: 'Scanne pour installer',
    ios: 'App Store',
    android: 'Google Play',
    iosSub: 'Télécharger sur',
    androidSub: 'Disponible sur',
  },
  en: {
    kicker: 'Keep playing on your phone',
    title: 'The same game, in your pocket',
    text: 'Your account links the two: progress, badges and your Daily Challenge streak follow you. The app adds the daily challenge notification, so you never miss it.',
    scan: 'Scan to install',
    ios: 'App Store',
    android: 'Google Play',
    iosSub: 'Download on the',
    androidSub: 'Get it on',
  },
  es: {
    kicker: 'Sigue en tu teléfono',
    title: 'El mismo juego, en tu bolsillo',
    text: 'Tu cuenta enlaza ambos: el progreso, las insignias y tu racha del Reto del día te siguen. La app añade la notificación del reto diario, para no perdértelo.',
    scan: 'Escanea para instalar',
    ios: 'App Store',
    android: 'Google Play',
    iosSub: 'Descargar en',
    androidSub: 'Disponible en',
  },
};

const t = copy[lang];
---

<section class="game-cta" aria-labelledby="game-cta-title">
  <div class="game-cta__inner">
    <div class="game-cta__text">
      <span class="game-cta__kicker">{t.kicker}</span>
      <h2 class="game-cta__title" id="game-cta-title">{t.title}</h2>
      <p class="game-cta__body">{t.text}</p>

      <div class="game-cta__stores">
        <a
          href={appStoreUrl(lang)}
          class="game-cta__store"
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="store-click"
          data-umami-event-store="app-store"
          data-umami-event-campaign="game-below"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
          <span class="game-cta__store-txt">
            <small>{t.iosSub}</small>
            <strong>{t.ios}</strong>
          </span>
        </a>

        <a
          href={playStoreUrl('game-below', lang)}
          class="game-cta__store"
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event="store-click"
          data-umami-event-store="play-store"
          data-umami-event-campaign="game-below"
        >
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>
          <span class="game-cta__store-txt">
            <small>{t.androidSub}</small>
            <strong>{t.android}</strong>
          </span>
        </a>
      </div>
    </div>

    <a href={qrTarget} class="game-cta__qr" aria-label={t.scan}>
      <span class="game-cta__qr-code" set:html={qrSvg}></span>
      <span class="game-cta__qr-foot">{t.scan}</span>
    </a>
  </div>
</section>

<style>
  /* Même largeur et mêmes gouttières que le plateau de jeu : le bloc se lit
     comme la suite de la partie, pas comme une bannière rapportée. */
  .game-cta {
    max-width: 720px;
    margin: 0 auto;
    /* Détaché de la barre de navigation : sans cet écart, le bloc se lisait
       comme un cinquième onglet plutôt que comme une nouvelle proposition. */
    padding: 44px var(--game-gutter) 48px;
  }

  .game-cta__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px;
    border-radius: 24px;
    background: #fff;
    border: 2px solid #e8dfcd;
    box-shadow: 0 10px 30px -22px rgb(26 24 22 / 60%);
  }

  .game-cta__text {
    flex: 1;
    min-width: 0;
  }

  .game-cta__kicker {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #ff5e3a;
    margin-bottom: 4px;
  }

  .game-cta__title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;
    margin: 0 0 6px;
    color: #1a1816;
  }

  .game-cta__body {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: #6e665c;
    margin: 0 0 16px;
  }

  .game-cta__stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .game-cta__store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px 9px 13px;
    border-radius: 14px;
    background: #1a1816;
    color: #fff;
    text-decoration: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .game-cta__store:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -12px rgb(26 24 22 / 80%);
  }

  .game-cta__store-txt {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .game-cta__store-txt small {
    font-size: 10px;
    opacity: 0.75;
  }

  .game-cta__store-txt strong {
    font-size: 15px;
    font-weight: 800;
  }

  .game-cta__qr {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border-radius: 18px;
    background: #fbf4eb;
    border: 2px solid #e8dfcd;
    text-decoration: none;
  }

  .game-cta__qr-code {
    display: block;
    width: 108px;
    height: 108px;
  }

  .game-cta__qr-code :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .game-cta__qr-foot {
    font-size: 11px;
    font-weight: 800;
    color: #6e665c;
    text-align: center;
    max-width: 108px;
  }

  /* Le QR code ne sert à rien sur le téléphone qu'il faudrait scanner :
     sous 720px, seuls les boutons stores restent. */
  @media (max-width: 719px) {
    .game-cta__qr {
      display: none;
    }
  }
</style>
