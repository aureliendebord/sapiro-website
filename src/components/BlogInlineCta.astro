---
import type { Lang } from '../i18n';
import { appStoreUrl, playStoreUrl } from '../data/appLinks';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy: Record<Lang, { kicker: string; title: string; subtitle: string }> = {
  fr: {
    kicker: 'L\'app SAPIRO',
    title: 'Transforme cette lecture en quiz.',
    subtitle: '2 000+ questions en photos. Gratuit, sans pub.',
  },
  en: {
    kicker: 'The SAPIRO app',
    title: 'Turn this read into a quiz.',
    subtitle: '2,000+ photo questions. Free, no ads.',
  },
  es: {
    kicker: 'La app SAPIRO',
    title: 'Convierte esta lectura en un quiz.',
    subtitle: '2 000+ preguntas en fotos. Gratis, sin anuncios.',
  },
};

const t = copy[lang];
---

<!--
  La bannière est rendue dans un <template> puis insérée par script avant le
  3e H2 de l'article (lecteur déjà engagé, pause naturelle entre deux
  sections). Articles courts (< 4 H2) : pas d'insertion, le CTA de fin et le
  sticky suffisent.
-->
<template id="inline-cta-template">
  <aside class="inline-cta">
    <div class="inline-cta-phone">
      <img src={`/images/banner/quiz-${lang}.webp`} alt="SAPIRO" width="320" height="695" loading="lazy" />
    </div>
    <div class="inline-cta-body">
      <span class="inline-cta-kicker">{t.kicker}</span>
      <p class="inline-cta-title">{t.title}</p>
      <p class="inline-cta-sub">{t.subtitle}</p>
      <div class="inline-cta-stores">
        <a href={appStoreUrl(lang)} class="store" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.09997 22C7.78997 22.05 6.79997 20.68 5.95997 19.47C4.24997 17 2.93997 12.45 4.69997 9.39C5.56997 7.87 7.12997 6.91 8.81997 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.09 16.67C20.06 16.74 19.67 18.11 18.71 19.5ZM13 3.5C13.73 2.67 14.94 2.04 15.94 2C16.07 3.17 15.6 4.35 14.9 5.19C14.21 6.04 13.07 6.7 11.95 6.61C11.8 5.46 12.36 4.26 13 3.5Z"/></svg>
          App Store
        </a>
        <a href={playStoreUrl('inline-banner', lang)} class="store" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5ZM16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12ZM20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.9 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81ZM6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"/></svg>
          Google Play
        </a>
      </div>
    </div>
  </aside>
</template>

<script is:inline>
(() => {
  const template = document.getElementById('inline-cta-template');
  const content = document.getElementById('article-content');
  if (!template || !content) return;

  const headings = content.querySelectorAll('h2');
  if (headings.length < 4) return;

  headings[2].parentNode.insertBefore(template.content.cloneNode(true), headings[2]);
})();
</script>

<style>
  .inline-cta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 40px 0;
    padding: 24px 28px;
    background: linear-gradient(135deg, #FFF7ED, #FEF3C7);
    border: 2px solid rgba(255, 107, 53, 0.2);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .inline-cta-phone {
    flex-shrink: 0;
    width: 104px;
    margin-bottom: -48px;
  }

  .inline-cta-phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 12px 28px -8px rgba(10, 10, 15, 0.35);
    transform: rotate(-4deg);
    animation: inline-cta-float 4.5s ease-in-out infinite;
  }

  @keyframes inline-cta-float {
    0%, 100% { transform: rotate(-4deg) translateY(0); }
    50% { transform: rotate(-4deg) translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-cta-phone img { animation: none; }
  }

  .inline-cta-body {
    min-width: 0;
  }

  .inline-cta-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange);
    margin-bottom: 6px;
  }

  .inline-cta-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--noir);
    line-height: 1.3;
    margin: 0 0 4px;
  }

  .inline-cta-sub {
    font-size: 0.95rem;
    color: var(--gris);
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .inline-cta-stores {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .inline-cta .store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: #0a0a0f;
    color: #fff;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .inline-cta .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -8px rgba(10, 10, 15, 0.5);
  }

  @media (max-width: 480px) {
    .inline-cta {
      gap: 16px;
      padding: 20px 16px;
    }

    .inline-cta-phone {
      width: 84px;
      margin-bottom: -40px;
    }

    .inline-cta-title {
      font-size: 1.1rem;
    }

    .inline-cta .store {
      padding: 9px 13px;
      font-size: 13px;
    }
  }
</style>
