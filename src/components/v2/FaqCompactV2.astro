---
import type { Lang } from '../../i18n';
import { getLocalePath } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  fr: {
    kicker: 'On répond',
    title: 'Les questions\nqu\'on nous pose le plus.',
    items: [
      { q: 'SAPIRO est-il vraiment gratuit ?', a: 'Oui, et sans publicité. Chaque jour, tu as 3 parties gratuites (duels compris) et le Défi du jour, sur les 5 univers. Sapiro+ débloque les parties illimitées et tous les parcours.' },
      { q: 'Vous collectez mes données ?', a: 'Le strict nécessaire, et on ne revend rien. Pas de publicité ni de cookie publicitaire. On mesure l\'usage (parties jouées, pages vues) pour améliorer Sapiro. Le compte est facultatif : il sert à sauvegarder ta progression et ton abonnement.' },
      { q: 'L\'app fonctionne hors ligne ?', a: 'Les quiz fonctionnent sans connexion : tout le contenu est téléchargé avec l\'app. Seuls les duels et les mises à jour de contenu nécessitent du réseau.' },
      { q: 'C\'est adapté aux enfants ?', a: 'Parfaitement. Aucune publicité, aucun contenu tiers, aucun compte obligatoire, aucune donnée revendue. Les enfants peuvent jouer seuls en toute autonomie.' },
    ],
    more: 'Voir toutes les questions',
  },
  en: {
    kicker: 'We answer',
    title: 'The questions\nwe get most.',
    items: [
      { q: 'Is SAPIRO really free?', a: 'Yes, and ad-free. Every day you get 3 free games (duels included) and the Daily Challenge, across all 5 worlds. Sapiro+ unlocks unlimited games and every path.' },
      { q: 'Do you collect my data?', a: 'Only what\'s needed, and we never sell anything. No ads, no advertising cookies. We measure usage (games played, pages viewed) to improve Sapiro. An account is optional: it only saves your progress and subscription.' },
      { q: 'Does the app work offline?', a: 'Quizzes work without a connection: all content is bundled with the app. Only duels and content updates require the network.' },
      { q: 'Is it kid-friendly?', a: 'Perfectly. No ads, no third-party content, no mandatory account, no data ever sold. Kids can play solo in full autonomy.' },
    ],
    more: 'See all questions',
  },
  es: {
    kicker: 'Respondemos',
    title: 'Las preguntas\nque mas nos hacen.',
    items: [
      { q: 'SAPIRO es realmente gratis?', a: 'Sí, y sin publicidad. Cada día tienes 3 partidas gratis (duelos incluidos) y el Reto del día, en los 5 mundos. Sapiro+ desbloquea partidas ilimitadas y todos los recorridos.' },
      { q: 'Recolectan mis datos?', a: 'Solo lo necesario, y no vendemos nada. Sin publicidad ni cookies publicitarias. Medimos el uso (partidas jugadas, páginas vistas) para mejorar Sapiro. La cuenta es opcional: solo guarda tu progreso y tu suscripción.' },
      { q: 'Funciona sin conexion?', a: 'Los quizzes funcionan sin conexion: todo el contenido se descarga con la app. Solo los duelos y las actualizaciones de contenido requieren red.' },
      { q: 'Apta para ninos?', a: 'Perfectamente. Sin anuncios, sin contenido de terceros, sin cuenta obligatoria, ningún dato vendido. Los ninos pueden jugar solos con total autonomia.' },
    ],
    more: 'Ver todas las preguntas',
  },
};

const t = copy[lang];
---

<section class="faq-v2">
  <div class="container">
    <div class="head">
      <span class="kicker">❓ {t.kicker}</span>
      <h2 class="title">{t.title}</h2>
    </div>

    <div class="list">
      {t.items.map((item, i) => (
        <details class="item" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="toggle" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <div class="foot">
      <a href={getLocalePath('/faq', lang)} class="more-link">{t.more} →</a>
    </div>
  </div>
</section>

<style>
  .faq-v2 {
    background: #FBF4EB;
    padding: 96px 0;
  }

  .head {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .kicker {
    display: inline-block;
    padding: 6px 14px;
    background: #FFE4DB;
    color: #B13818;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: #2A1A14;
    white-space: pre-line;
  }

  .list {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .item {
    background: #fff;
    border-radius: 16px;
    border: 1px solid #E8DFCD;
    overflow: hidden;
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .item:hover {
    border-color: #d1d5db;
  }

  .item[open] {
    border-color: #FF5E3A;
    box-shadow: 0 20px 40px -20px rgba(255, 94, 58, 0.2);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    color: #2A1A14;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }

  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #F3EADA;
    border-radius: 50%;
    color: #6E665C;
    transition: transform 0.3s, background 0.2s;
    flex-shrink: 0;
  }

  .item[open] .toggle {
    transform: rotate(180deg);
    background: #FF5E3A;
    color: #fff;
  }

  .item p {
    padding: 0 24px 22px;
    font-size: 15px;
    color: #5A4E45;
    line-height: 1.65;
    margin: 0;
  }

  .foot {
    text-align: center;
    margin-top: 32px;
  }

  .more-link {
    color: #FF5E3A;
    font-weight: 600;
    font-size: 15px;
    transition: color 0.2s;
  }

  .more-link:hover { color: #E9401F; }

  @media (max-width: 520px) {
    .faq-v2 { padding: 64px 0; }
    summary { padding: 18px 18px; font-size: 15px; }
    .item p { padding: 0 18px 18px; font-size: 14px; }
  }
</style>
