---
import type { Lang } from '../../i18n';
import { playGameUrl, type PlayCampaign } from '../../data/appLinks';

interface Props {
  lang: Lang;
  /**
   * 'anchor' : scroll vers la section #download de la page courante
   * (home, index blog). 'play' : lien vers le jeu en ligne — le CTA
   * principal du site converge vers le jeu, pas vers les stores.
   */
  mode?: 'anchor' | 'play';
  /** Permet de distinguer les emplacements du sticky dans Umami (articles vs piliers). */
  campaign?: Extract<PlayCampaign, 'sticky-cta' | 'sticky-pillar'>;
}

const { lang, mode = 'play', campaign = 'sticky-cta' } = Astro.props;

const copy = {
  fr: { anchor: 'Télécharger SAPIRO', play: 'Jouer maintenant', free: 'Gratuit', extra: 'Sans installation' },
  en: { anchor: 'Download SAPIRO', play: 'Play now', free: 'Free', extra: 'No install' },
  es: { anchor: 'Descargar SAPIRO', play: 'Jugar ahora', free: 'Gratis', extra: 'Sin instalación' },
  de: { anchor: 'SAPIRO laden', play: 'Jetzt spielen', free: 'Kostenlos', extra: 'Ohne Installation' },
};

const t = copy[lang];
const label = mode === 'anchor' ? t.anchor : t.play;
const href = mode === 'anchor' ? '#download' : playGameUrl(campaign, lang);
---

<div class="sticky-bar" id="sticky-cta">
  <img src="/images/icon-180.png" alt="" aria-hidden="true" class="sticky-bar-icon" width="40" height="40" />
  <p class="sticky-bar-text">{mode === 'anchor' ? t.free : `${t.free} · ${t.extra}`}</p>
  <a
    href={href}
    class="sticky-bar-btn"
    data-umami-event={mode === 'play' ? 'play-click' : undefined}
    data-umami-event-campaign={mode === 'play' ? campaign : undefined}
  >{label}</a>
</div>

<script is:inline>
(() => {
  const cta = document.getElementById('sticky-cta');
  if (!cta) return;

  const onScroll = () => {
    cta.classList.toggle('visible', window.scrollY >= 400);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>
