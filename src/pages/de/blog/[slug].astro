---
import { render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { extractFaqFromMarkdown } from '../../../utils/faq';
import { extractListFromMarkdown } from '../../../utils/list';
import { blogStaticPaths } from '../../../utils/blogPaths';

export async function getStaticPaths() {
  return blogStaticPaths('de');
}

const { post, translationSlugs } = Astro.props;
const { Content } = await render(post);
const faqItems = extractFaqFromMarkdown(post.body || '');
const listItems = extractListFromMarkdown(post.body || '');
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  lastModified={post.data.lastModified}
  lang={post.data.lang}
  slug={post.data.urlSlug}
  category={post.data.category}
  author={post.data.author}
  readingTime={post.data.readingTime}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  imageCredit={post.data.imageCredit}
  faqItems={faqItems}
  listItems={listItems}
  translationSlugs={translationSlugs}
  canonicalTo={post.data.canonicalTo}
  quiz={post.data.quiz}
  printable={post.data.printable}
>
  <Content />
</BlogPost>
