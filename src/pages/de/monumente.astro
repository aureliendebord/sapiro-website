---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileCta from '../../components/v2/StickyMobileCta.astro';
import { getTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const lang = 'de';
const t = getTranslations(lang);

// Nur ein Teil der Artikel ist auf Deutsch übersetzt: Jede kuratierte Liste
// wird über translationKey aufgelöst, Einträge ohne deutschen Artikel fallen weg,
// leere Abschnitte werden ausgeblendet.
const allPosts = await getCollection('blog');
const dePosts = allPosts
  .filter(p => p.data.lang === 'de')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byKey = new Map(dePosts.map(p => [p.data.translationKey, p]));

const curated = [
  {
    title: 'Die Klassiker',
    items: [
      { key: 'merveilles-du-monde', label: 'Die 7 Weltwunder (antike und neue)' },
      { key: 'monuments-celebres', label: '30 berühmte Monumente der Welt zum Erkennen' },
      { key: 'monuments-plus-visites', label: 'Die meistbesuchten Monumente der Welt' },
    ],
  },
  {
    title: 'Monumente nach Reiseziel',
    items: [
      { key: 'monuments-france', label: 'Die schönsten Monumente Frankreichs' },
      { key: 'monuments-paris', label: 'Die Monumente von Paris, die man kennen sollte' },
      { key: 'monuments-italie', label: 'Die Monumente Italiens' },
      { key: 'monuments-egypte', label: 'Die Monumente Ägyptens' },
      { key: 'monuments-espagne', label: 'Die Monumente Spaniens' },
      { key: 'monuments-royaume-uni', label: 'Die Monumente des Vereinigten Königreichs' },
    ],
  },
  {
    title: 'Welterbe und große Epochen',
    items: [
      { key: 'sites-unesco', label: 'Das UNESCO-Welterbe' },
      { key: 'monuments-antiquite', label: 'Die Monumente der Antike (Ägypten, Griechenland, Rom)' },
      { key: 'chateaux-palais-celebres', label: 'Berühmte Schlösser und Paläste der Welt' },
    ],
  },
  {
    title: 'Wiederholen und spielen',
    items: [
      { key: 'quiz-monuments', label: 'Quiz: Monumente der Welt' },
      { key: 'monuments-concours', label: 'Monumente, die man für Prüfungen kennen sollte' },
    ],
  },
];

const sections = curated
  .map(s => ({
    title: s.title,
    items: s.items
      .flatMap(i => {
        const post = byKey.get(i.key);
        return post ? [{ label: i.label, post }] : [];
      }),
  }))
  .filter(s => s.items.length > 0);

const shownKeys = new Set(curated.flatMap(s => s.items.map(i => i.key)));
const monCategories = ['monuments'];
const moreArticles = dePosts.filter(
  p => monCategories.includes(p.data.category) && !shownKeys.has(p.data.translationKey),
);

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Monumente der Welt: Weltwunder, UNESCO-Stätten und berühmte Bauwerke",
  "description": "Alles über die Monumente der Welt: die 7 antiken und neuen Weltwunder, UNESCO-Stätten, die meistbesuchten Monumente, die Monumente von Paris und Frankreich.",
  "url": "https://sapiro.app/de/monumente/",
  "inLanguage": "de",
  "dateModified": "2026-06-15",
  "publisher": {
    "@type": "Organization",
    "name": "SAPIRO",
    "logo": { "@type": "ImageObject", "url": "https://sapiro.app/images/icon-1024.png" }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Was sind die 7 Weltwunder?", "acceptedAnswer": { "@type": "Answer", "text": "Die 7 Weltwunder der Antike waren die Cheops-Pyramide von Gizeh, die Hängenden Gärten von Babylon, die Zeusstatue von Olympia, der Tempel der Artemis in Ephesos, das Mausoleum von Halikarnassos, der Koloss von Rhodos und der Leuchtturm von Alexandria. Nur die Cheops-Pyramide steht noch. Die 7 neuen Weltwunder, 2007 in einer weltweiten Abstimmung gewählt, sind die Chinesische Mauer, Petra, die Christusstatue Cristo Redentor, Machu Picchu, Chichén Itzá, das Kolosseum und das Taj Mahal." } },
    { "@type": "Question", "name": "Welches Monument ist das meistbesuchte der Welt?", "acceptedAnswer": { "@type": "Answer", "text": "Die Verbotene Stadt in Peking ist mit 17 bis 19 Millionen Besuchern pro Jahr das meistbesuchte Monument der Welt. Unter den Monumenten mit Eintritt liegt der Eiffelturm mit fast 6,2 Millionen Besuchern pro Jahr vorn." } },
    { "@type": "Question", "name": "Wie viele Stätten gehören zum UNESCO-Welterbe?", "acceptedAnswer": { "@type": "Answer", "text": "Die UNESCO zählt über 1200 Welterbestätten in rund 170 Ländern. Italien und China haben die meisten Stätten, jeweils etwa sechzig." } },
    { "@type": "Question", "name": "Welches Monument ist das meistbesuchte in Frankreich?", "acceptedAnswer": { "@type": "Answer", "text": "Die Kathedrale Notre-Dame de Paris ist das meistbesuchte Monument Frankreichs, vor der Basilika Sacré-Cœur und dem Louvre. Der Eiffelturm bleibt das meistbesuchte Monument mit Eintritt im Land." } }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://sapiro.app/de/" },
    { "@type": "ListItem", "position": 2, "name": "Monumente" }
  ]
};
---

<Layout title="Monumente der Welt: Ratgeber und Quiz | SAPIRO" description="Monumente der Welt: die 7 Weltwunder, UNESCO-Stätten, die meistbesuchten Monumente, Paris und Frankreich. Ratgeber und Quiz zum Allgemeinwissen." lang={lang}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header lang={lang} t={t} />

  <main class="pillar-page">
    <article class="container">
      <header class="pillar-header">
        <h1>Monumente der Welt</h1>
        <p class="lede">Von den Pyramiden Ägyptens bis zum Eiffelturm: Monumente erzählen die Geschichte der Zivilisationen. Weltwunder, UNESCO-Stätten und Meisterwerke zum Erkennen.</p>
      </header>

      <section class="pillar-intro">
        <p>Ein Monument ist Geschichte, die noch steht. Hinter jedem berühmten Bauwerk stecken eine Epoche, eine Technik und eine Absicht: beeindrucken, beten, verteidigen, erinnern. Das Kolosseum, das Taj Mahal oder Machu Picchu zu erkennen und zu verstehen, warum sie gebaut wurden, gehört zu den Grundlagen des Allgemeinwissens.</p>
        <p>SAPIRO bietet Quiz zu den bekanntesten Monumenten aller Kontinente, mit einer Erklärung zum Kontext hinter jeder Frage: wer es gebaut hat, wann und was es einzigartig macht.</p>
      </section>

      <section class="pillar-stats">
        <h2>Monumente in Zahlen</h2>
        <ul>
          <li><strong>1200+</strong> Stätten auf der Liste des UNESCO-Welterbes</li>
          <li><strong>Nur 1</strong> der 7 antiken Weltwunder steht noch: die Cheops-Pyramide von Gizeh</li>
          <li><strong>2007</strong>: Wahl der 7 neuen Weltwunder in einer weltweiten Abstimmung</li>
          <li><strong>17–19 Millionen</strong> Besucher pro Jahr in der Verbotenen Stadt, dem meistbesuchten Monument</li>
          <li><strong>330 Meter</strong>: Höhe des Eiffelturms, des meistbesuchten Monuments mit Eintritt der Welt</li>
        </ul>
      </section>

      {sections.map(s => (
        <section class="pillar-sub">
          <h2>{s.title}</h2>
          <ul class="pillar-grid">
            {s.items.map(i => (
              <li><a href={`/de/blog/${i.post.data.urlSlug}/`}>{i.label}</a></li>
            ))}
          </ul>
        </section>
      ))}

      {moreArticles.length > 0 && (
        <section class="pillar-sub">
          <h2>Weitere Artikel</h2>
          <ul class="pillar-grid">
            {moreArticles.map(p => (
              <li><a href={`/de/blog/${p.data.urlSlug}/`}>{p.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="pillar-faq">
        <h2>Häufige Fragen zu Monumenten</h2>

        <h3>Was sind die 7 Weltwunder?</h3>
        <p>Die 7 Weltwunder der Antike waren die Cheops-Pyramide von Gizeh, die Hängenden Gärten von Babylon, die Zeusstatue von Olympia, der Tempel der Artemis in Ephesos, das Mausoleum von Halikarnassos, der Koloss von Rhodos und der Leuchtturm von Alexandria. Nur die Cheops-Pyramide steht noch. Die 7 neuen Weltwunder, 2007 in einer weltweiten Abstimmung gewählt, sind die Chinesische Mauer, Petra, die Christusstatue Cristo Redentor, Machu Picchu, Chichén Itzá, das Kolosseum und das Taj Mahal.</p>

        <h3>Welches Monument ist das meistbesuchte der Welt?</h3>
        <p>Die Verbotene Stadt in Peking ist mit 17 bis 19 Millionen Besuchern pro Jahr das meistbesuchte Monument der Welt. Unter den Monumenten mit Eintritt liegt der Eiffelturm mit fast 6,2 Millionen Besuchern pro Jahr vorn.</p>

        <h3>Wie viele Stätten gehören zum UNESCO-Welterbe?</h3>
        <p>Die UNESCO zählt über 1200 Welterbestätten in rund 170 Ländern. Italien und China haben die meisten Stätten, jeweils etwa sechzig.</p>

        <h3>Welches Monument ist das meistbesuchte in Frankreich?</h3>
        <p>Die Kathedrale Notre-Dame de Paris ist das meistbesuchte Monument Frankreichs, vor der Basilika Sacré-Cœur und dem Louvre. Der Eiffelturm bleibt das meistbesuchte Monument mit Eintritt im Land.</p>
      </section>
    </article>
  </main>

  <Footer lang={lang} t={t} />
  <StickyMobileCta lang={lang} campaign="sticky-pillar" />
</Layout>

<style>
  .pillar-page { padding-top: 100px; padding-bottom: 60px; }
  .pillar-header { text-align: center; padding-bottom: 32px; margin-bottom: 32px; border-bottom: 1px solid var(--gris-clair); }
  .pillar-header h1 { font-size: clamp(2.25rem, 4.5vw, 3.25rem); margin-bottom: 16px; }
  .lede { font-size: 1.25rem; color: var(--gris); max-width: 720px; margin: 0 auto; }
  .pillar-intro, .pillar-stats, .pillar-sub, .pillar-faq { max-width: 800px; margin: 0 auto 48px; }
  .pillar-intro p { line-height: 1.75; margin-bottom: 16px; font-size: 1.05rem; }
  .pillar-stats ul { padding-left: 24px; }
  .pillar-stats li { margin-bottom: 8px; line-height: 1.7; }
  .pillar-sub h2, .pillar-stats h2, .pillar-faq h2 { font-size: 1.75rem; margin-bottom: 20px; }
  .pillar-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .pillar-grid li { padding: 14px 18px; background: var(--gris-clair); border-radius: 8px; }
  .pillar-grid a { color: var(--noir); text-decoration: none; font-weight: 500; }
  .pillar-grid a:hover { color: var(--orange); }
  .pillar-faq h3 { font-size: 1.1rem; margin-top: 24px; margin-bottom: 8px; }
  .pillar-faq p { line-height: 1.7; margin-bottom: 16px; }
</style>
